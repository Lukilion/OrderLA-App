{
  "entities": {
    "UserAccount": {
      "title": "UserAccount",
      "description": "User account and permission profile in OrderLa Wholesale BOS",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user identifier" },
        "username": { "type": "string", "description": "Login username" },
        "password": { "type": "string", "description": "Account password" },
        "name": { "type": "string", "description": "Full name of the user" },
        "email": { "type": "string", "description": "Contact email address" },
        "phone": { "type": "string", "description": "Contact phone or WhatsApp" },
        "role": { "type": "string", "description": "Assigned access role", "enum": ["superadmin", "admin", "buyer", "auditor", "purchaser"] },
        "requestedRole": { "type": "string", "description": "Role requested upon registration" },
        "status": { "type": "string", "description": "Account approval status", "enum": ["pending", "active", "rejected"] },
        "canExportExcel": { "type": "boolean", "description": "Excel spreadsheet export capability" },
        "canExportPdf": { "type": "boolean", "description": "PDF invoice export capability" },
        "canSendWhatsApp": { "type": "boolean", "description": "WhatsApp dispatch capability" },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "notes": { "type": "string", "description": "Applicant shop or market notes" }
      },
      "required": ["id", "username", "name", "role", "status"]
    },
    "WholesaleItem": {
      "title": "WholesaleItem",
      "description": "Wholesale inventory product with live rate and demand",
      "type": "object",
      "properties": {
        "id": { "type": "number", "description": "Unique catalog number" },
        "name": { "type": "string", "description": "Urdu and English product name" },
        "cat": { "type": "string", "description": "Wholesale market or vendor category" },
        "rate": { "type": "number", "description": "Base rate in PKR" },
        "stock": { "type": "string", "description": "Current stock count" },
        "demand": { "type": "number", "description": "Demanded purchase quantity" },
        "status": { "type": "string", "description": "Stock status indicator" }
      },
      "required": ["id", "name", "cat", "rate", "status"]
    },
    "AppUpdateRelease": {
      "title": "AppUpdateRelease",
      "description": "Live release versioning, OTA bundle links, and mandatory update signals for APK and EXE",
      "type": "object",
      "properties": {
        "version": { "type": "string", "description": "Semantic release version" },
        "minRequiredVersion": { "type": "string", "description": "Minimum required version to access the app" },
        "titleUrdu": { "type": "string", "description": "Update title in Urdu" },
        "titleEn": { "type": "string", "description": "Update title in English" },
        "notesUrdu": { "type": "string", "description": "Release notes in Urdu" },
        "notesEn": { "type": "string", "description": "Release notes in English" },
        "forceUpdate": { "type": "boolean", "description": "Whether update is strictly mandatory" },
        "apkDownloadUrl": { "type": "string", "description": "Direct download link for Android APK" },
        "exeDownloadUrl": { "type": "string", "description": "Direct download link for Windows EXE" },
        "bundleZipUrl": { "type": "string", "description": "Direct link to Capgo OTA bundle zip" },
        "publishedAt": { "type": "string", "description": "Publication timestamp" }
      },
      "required": ["version", "minRequiredVersion", "forceUpdate"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserAccount",
      "description": "User profiles, pending registrations, and access permissions"
    },
    "/catalog/{itemId}": {
      "schema": "WholesaleItem",
      "description": "Master wholesale catalog items with real-time rate updates"
    },
    "/saved_orders/{orderId}": {
      "schema": "SavedOrder",
      "description": "Cross-device saved orders, drafts, and dispatch archives"
    },
    "/audit_history/{entryId}": {
      "schema": "AuditHistoryEntry",
      "description": "Enterprise audit log tracking user changes, rate modifications, and operations"
    },
    "/app_updates/{docId}": {
      "schema": "AppUpdateRelease",
      "description": "Live app update manifests and OTA sync signals"
    }
  }
}
